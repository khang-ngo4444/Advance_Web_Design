<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1><%= title %></h1>

  <p><b>Tên:</b> <%= product.name %></p>
  <p><b>Giá:</b> <%= product.price %></p>
  <p><b>Loại:</b> <%= product.categoryId ? product.categoryId.name : 'Không có' %></p>
  <p><b>Tồn kho:</b> <%= product.stock %></p>
  <p><b>Mô tả:</b> <%= product.description %></p>

  <a href="/products/edit/<%= product._id %>">Sửa</a> |
  <a href="/products">Quay lại</a>
</body>
</html>
