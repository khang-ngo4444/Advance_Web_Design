<div class="product">
  <% if (product.image) { %>
    <img src="<%= product.image %>" alt="<%= product.name %>" width="200">
  <% } %>
  <h3><%= product.name %></h3>
  <p>$<%= product.price %></p>
  <% if (product.tag) { %>
    <span class="tag"><%= product.tag %></span>
  <% } %>
  <button>Buy now</button>
</div>
