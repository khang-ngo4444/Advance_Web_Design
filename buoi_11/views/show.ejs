<%- include('partials/head', { title: product.name }) %>
    <div class="detail">
      <div class="mat"><img src="<%= product.image %>" alt="<%= product.name %>"></div>
      <div>
        <h1><%= product.name %></h1>
        <dl>
          <div><dt>Price</dt><dd>$<%= product.price %></dd></div>
          <div><dt>Quantity</dt><dd><%= product.quantity %></dd></div>
        </dl>
        <a href="/edit/<%= product._id %>" class="button">Edit</a>
        <a href="/" class="button">Back to product list</a>
      </div>
    </div>
<%- include('partials/foot') %>
