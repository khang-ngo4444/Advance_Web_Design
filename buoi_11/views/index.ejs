<%- include('partials/head', { title: 'Product List' }) %>
    <div class="page-head">
      <h1>Product List</h1>
      <a href="/add" class="button button-solid">Add new product</a>
    </div>
    <form action="/search" method="GET" class="search">
      <label for="q" class="sr-only">Search by name</label>
      <input id="q" type="search" name="q" placeholder="Search by name" value="<%= locals.q || '' %>" required>
      <button type="submit" class="button">Search</button>
      <% if (locals.q) { %><a href="/">Show all products</a><% } %>
    </form>
    <% if (locals.q) { %>
      <p class="result-note"><%= products.length %> result<%= products.length === 1 ? '' : 's' %> for “<%= q %>”</p>
    <% } %>

    <% if (!products.length) { %>
      <p class="empty">No products found. <a href="/add">Add one.</a></p>
    <% } %>
    <div class="row catalogue">
      <% products.forEach(product => { %>
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
          <div class="card">
            <a href="/products/<%= product._id %>" class="mat">
              <img src="<%= product.image %>" class="card-img-top" alt="<%= product.name %>">
            </a>
            <div class="card-body">
              <h5 class="card-title"><span class="name"><%= product.name %></span><span class="leader"></span><span class="price">$<%= product.price %></span></h5>
              <p class="card-text">Quantity: <%= product.quantity %></p>
              <div class="card-actions">
                <a href="/products/<%= product._id %>" class="button button-small">View details</a>
                <a href="/edit/<%= product._id %>" class="button button-small">Edit</a>
                <form action="/delete/<%= product._id %>" method="POST" onsubmit="return confirm('Delete this product?')">
                  <button type="submit" class="button button-small button-danger">Delete</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
<%- include('partials/foot') %>
